@model FineVm
@{ var editing = Model.Id > 0; ViewData["Title"] = editing ? "Ceza düzenle" : "Yeni ceza"; }
<a class="back-link" asp-action="Index">← Trafik cezalarına dön</a><div class="page-heading"><div><p class="eyebrow">CEZA KAYDI</p><h1>@(editing ? "Ceza bilgilerini düzenle" : "Yeni ceza kaydı")</h1><p class="muted">Kaydı oluşturduktan sonra detay ekranından yönetici onayına gönderebilirsiniz.</p></div></div>
<section class="panel form-panel"><form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : (int?)null)" method="post"><input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid">
<div class="field"><label asp-for="VehicleId"></label><select asp-for="VehicleId" asp-items="Model.Vehicles"><option value="">Araç seçin</option></select><span asp-validation-for="VehicleId"></span>@if (Model.Vehicles.Count == 0) { <a class="text-link" asp-controller="Vehicles" asp-action="Create">Önce araç ekleyin →</a> }</div>
<div class="field"><label asp-for="ReferenceNumber"></label><input asp-for="ReferenceNumber" placeholder="Örn. TK-2026-001" /><span asp-validation-for="ReferenceNumber"></span></div>
<div class="field"><label asp-for="ViolationDate"></label><input asp-for="ViolationDate" type="date" asp-format="{0:yyyy-MM-dd}" /><span asp-validation-for="ViolationDate"></span></div>
<div class="field"><label asp-for="Amount"></label><input asp-for="Amount" type="text" inputmode="decimal" placeholder="1500,00" /><small class="muted">Ondalık ayırıcı olarak virgül kullanın.</small><span asp-validation-for="Amount"></span></div>
<div class="field span-2"><label asp-for="Description"></label><textarea asp-for="Description" rows="4" maxlength="1000" placeholder="İhlalin açıklaması ve ilgili bilgiler…"></textarea><span asp-validation-for="Description"></span></div></div>
<div class="form-actions"><a class="btn secondary" asp-action="Index">Vazgeç</a><button class="btn primary" type="submit">@(editing ? "Değişiklikleri kaydet" : "Ceza kaydını oluştur") →</button></div></form></section>

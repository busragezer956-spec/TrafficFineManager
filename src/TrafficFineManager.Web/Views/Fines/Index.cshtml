@model FineListVm
@{ ViewData["Title"] = "Trafik cezaları"; }
<div class="page-heading"><div><p class="eyebrow">CEZA VE ONAY YÖNETİMİ</p><h1>Trafik cezaları</h1><p class="muted">@Model.Total kayıt · Güncel durumları inceleyin, yetkiniz dahilinde işlem yapın.</p></div>@if (User.IsInRole(Roles.Operator)) { <a class="btn primary" asp-action="Create">＋ Yeni ceza kaydı</a> }</div>
@if (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Finance))
{
<nav class="filter-tabs" aria-label="Ceza listesi kapsamı"><a class="@(!Model.Mine ? "selected" : "")" asp-action="Index" asp-route-search="@Model.Search">Tüm kayıtlar</a><a class="@(Model.Mine ? "selected" : "")" asp-action="Index" asp-route-mine="true" asp-route-search="@Model.Search">Onayımı bekleyenler</a></nav>
}
<section class="panel"><form class="filters" method="get"><input type="hidden" name="mine" value="@Model.Mine.ToString().ToLowerInvariant()" /><div class="search"><label class="sr-only" for="search">Ceza ara</label><input id="search" name="search" value="@Model.Search" placeholder="Plaka veya tutanak numarası…" maxlength="60" /></div>@if (!Model.Mine) { <label class="sr-only" for="status">Durum</label><select asp-for="Status" asp-items="Html.GetEnumSelectList<FineStatus>()"><option value="">Tüm durumlar</option></select> }<button class="btn secondary" type="submit">Filtrele</button><a class="text-link" asp-action="Index">Temizle</a></form>
<partial name="_FineTable" model="Model.Items" />
<div class="panel-footer pagination"><span>@Model.Total kayıt · Sayfa @Model.Page / @Model.TotalPages</span><div>@if (Model.Page > 1) { <a class="btn secondary" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-mine="@Model.Mine">← Önceki</a> }@if (Model.Page < Model.TotalPages) { <a class="btn secondary" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-mine="@Model.Mine">Sonraki →</a> }</div></div></section>

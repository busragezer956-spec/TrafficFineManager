@model DashboardVm
@{ ViewData["Title"] = "Genel bakış"; }
<div class="page-heading"><div><p class="eyebrow">OPERASYON MERKEZİ</p><h1>Genel bakış</h1><p class="muted">Filonuzun ceza ve onay süreçlerini tek bakışta takip edin.</p></div>@if (User.IsInRole(Roles.Operator)) { <a class="btn primary" asp-controller="Fines" asp-action="Create">＋ Yeni ceza kaydı</a> } else if (User.IsInRole(Roles.Manager) || User.IsInRole(Roles.Finance)) { <a class="btn primary" asp-controller="Fines" asp-action="Index" asp-route-mine="true">Onayımı bekleyenler →</a> }</div>
<div class="metrics"><a class="metric" asp-controller="Vehicles" asp-action="Index"><span class="metric-icon">▣</span><p>Kayıtlı araç</p><strong>@Model.Vehicles</strong><small>Filodaki toplam araç</small></a><a class="metric" asp-controller="Fines" asp-action="Index" asp-route-status="ManagerApproval"><span class="metric-icon amber">◷</span><p>Yönetici onayı</p><strong>@Model.PendingManager</strong><small>İnceleme bekleyen kayıt</small></a><a class="metric" asp-controller="Fines" asp-action="Index" asp-route-status="FinanceApproval"><span class="metric-icon blue">↗</span><p>Finans onayı</p><strong>@Model.PendingFinance</strong><small>Son onayı bekleyen kayıt</small></a><a class="metric" asp-controller="Fines" asp-action="Index" asp-route-status="Completed"><span class="metric-icon green">✓</span><p>Tamamlanan</p><strong>@Model.Completed</strong><small>Onay süreci tamamlandı</small></a></div>
<section class="overview-strip"><div><span class="eyebrow">ONAY BEKLEYEN TOPLAM TUTAR</span><strong>@Model.PendingAmount.ToString("N2") <small>₺</small></strong></div><p>Her adım kayıt altında.<br /><span>Yeni → Yönetici Onayı → Finans Onayı → Tamamlandı</span></p><a class="btn ghost" asp-controller="Fines" asp-action="Index">Tüm kayıtları incele →</a></section>
<section class="panel"><div class="panel-heading"><div><h2>Son ceza kayıtları</h2><p class="muted">En son oluşturulan kayıtlar ve güncel durumları</p></div><a class="text-link" asp-controller="Fines" asp-action="Index">Tümünü gör →</a></div><partial name="_FineTable" model="Model.Recent" /></section>
<div class="info-line"><span>●</span> Tamamlanan kayıtlar korunur. Onay geçmişi her zaman görüntülenebilir.</div>
